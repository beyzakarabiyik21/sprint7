{
  "info": {
    "name": "Kampüs API",
    "description": "Kampüs Etkinlikleri REST API için 6 test isteği. Adres: http://localhost:3000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 - GET /health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('status ok + student', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('ok');",
              "  pm.expect(body.student).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2 - GET /events",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/events",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["events"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('6 kayıt', () => pm.expect(pm.response.json()).to.have.lengthOf(6));"
            ]
          }
        }
      ]
    },
    {
      "name": "3 - GET /events/event-2",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/events/event-2",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["events", "event-2"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('id event-2', () => pm.expect(pm.response.json().id).to.eql('event-2'));"
            ]
          }
        }
      ]
    },
    {
      "name": "4 - GET /events/yok",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/events/yok",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["events", "yok"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
              "pm.test('error mesajı', () => pm.expect(pm.response.json().error.message).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "5 - POST /events (tam body)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Git Atölyesi\",\n  \"category\": \"Atölye\",\n  \"date\": \"2026-12-01\",\n  \"capacity\": 30\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "http://localhost:3000/events",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["events"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('yeni id', () => pm.expect(pm.response.json().id).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "6 - POST /events (sadece title)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Git Atölyesi\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "http://localhost:3000/events",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["events"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('error mesajı', () => pm.expect(pm.response.json().error.message).to.be.a('string'));"
            ]
          }
        }
      ]
    }
  ]
}
